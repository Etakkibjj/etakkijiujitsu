                            </label>
                            <select id="athlete-division" required
                                class="vice-input w-full px-3 py-3 rounded-xl text-sm font-semibold cursor-pointer">
                                <option value="Juvenil (14-17)">Juvenil (14-17)</option>
                                <option value="Adulto (18-29)" selected>Adulto (18-29)</option>
                                <option value="Master 1 (30-35)">Master 1 (30-35)</option>
                                <option value="Master 2 (36-40)">Master 2 (36-40)</option>
                                <option value="Master 3+ (+41)">Master 3+ (+41)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Botón de Envío -->
                    <div class="pt-2">
                        <button type="submit"
                            class="btn-vice-primary w-full py-3.5 px-6 rounded-xl font-retro font-bold text-sm sm:text-base tracking-wider uppercase flex items-center justify-center gap-2.5 cursor-pointer">
                            <i class="fa-solid fa-plus-circle text-lg"></i>
                            <span>REGISTRAR EN EJJI 4</span>
                        </button>
                    </div>
                </form>

                <!-- Botón rápido para cargar atletas de demostración si la lista está vacía -->
                <div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-gray-400">
                    <span>¿Quieres probar la tabla?</span>
                    <button type="button" id="btn-seed-demo" class="text-vice-cyan hover:text-vice-pink underline font-semibold transition cursor-pointer">
                        + Cargar 4 atletas de ejemplo
                    </button>
                </div>
            </section>

            <!-- COLUMNA DERECHA: LISTADO EN VIVO, FILTROS Y EXPORTACIÓN (7 cols) -->
            <section class="lg:col-span-7 vice-card rounded-3xl p-6 sm:p-7 border-t-4 border-t-vice-cyan flex flex-col">
                <!-- Cabecera de la Lista y Botones de Exportación -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
                    <div>
                        <h2 class="font-retro text-xl sm:text-2xl font-bold text-white flex items-center gap-2.5">
                            <i class="fa-solid fa-list-ol text-vice-cyan"></i>
                            <span>ATLETAS PRE-INSCRIPTOS</span>
                        </h2>
                        <p class="text-xs text-gray-300 mt-1">Roster oficial actualizado en tiempo real</p>
                    </div>

                    <!-- Controles de Exportación -->
                    <div class="flex flex-wrap items-center gap-2">
                        <button type="button" id="btn-export-csv"
                            class="px-3.5 py-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/35 border border-emerald-400/50 text-emerald-300 font-retro text-xs font-bold flex items-center gap-1.5 transition cursor-pointer"
                            title="Descargar planilla compatible con Excel">
                            <i class="fa-solid fa-file-csv"></i>
                            <span>CSV</span>
                        </button>
                        <button type="button" id="btn-export-json"
                            class="px-3.5 py-2 rounded-xl bg-vice-cyan/20 hover:bg-vice-cyan/35 border border-vice-cyan/50 text-vice-cyan font-retro text-xs font-bold flex items-center gap-1.5 transition cursor-pointer"
                            title="Descargar respaldo de datos JSON">
                            <i class="fa-solid fa-file-code"></i>
                            <span>JSON</span>
                        </button>
                        <button type="button" id="btn-clear-all"
                            class="px-3.5 py-2 rounded-xl bg-red-500/20 hover:bg-red-500/35 border border-red-500/50 text-red-300 font-retro text-xs font-bold flex items-center gap-1.5 transition cursor-pointer"
                            title="Vaciar toda la lista">
                            <i class="fa-solid fa-trash-can"></i>
                            <span class="hidden sm:inline">Limpiar</span>
                        </button>
                    </div>
