    <style>
        /* Estilos personalizados Neon Retro Miami 90s / Vice City */
        :root {
            --neon-pink: #ff007f;
            --neon-cyan: #00f3ff;
            --neon-purple: #9d00ff;
            --neon-orange: #ff6a00;
            --bg-dark: #070210;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 50% 0%, rgba(157, 0, 255, 0.25) 0%, transparent 60%),
                radial-gradient(circle at 85% 20%, rgba(255, 0, 127, 0.2) 0%, transparent 45%),
                radial-gradient(circle at 15% 30%, rgba(0, 243, 255, 0.15) 0%, transparent 45%);
        }

        /* Grilla Retrowave en Perspectiva 3D */
        .synthwave-grid-container {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 42vh;
            perspective: 450px;
            z-index: -2;
            pointer-events: none;
            overflow: hidden;
        }

        .synthwave-grid {
            position: absolute;
            top: 0;
            left: -50%;
            width: 200%;
            height: 200%;
            background-image: 
                linear-gradient(to right, rgba(255, 0, 127, 0.35) 2px, transparent 2px),
                linear-gradient(to bottom, rgba(0, 243, 255, 0.35) 2px, transparent 2px);
            background-size: 60px 45px;
            transform: rotateX(72deg);
            transform-origin: top center;
            animation: gridMove 3.5s linear infinite;
            mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.8) 35%, rgba(0,0,0,1) 100%);
            -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.8) 35%, rgba(0,0,0,1) 100%);
        }

        @keyframes gridMove {
            0% { background-position: 0 0; }
            100% { background-position: 0 45px; }
        }

        /* Sol Atardecer Miami Outrun */
        .outrun-sun {
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: linear-gradient(180deg, #ffe600 0%, #ff7b00 45%, #ff007f 85%, #9d00ff 100%);
            box-shadow: 0 0 60px rgba(255, 0, 127, 0.6), 0 0 110px rgba(255, 123, 0, 0.4);
            position: relative;
            overflow: hidden;
        }

        .outrun-sun::after {
            content: '';
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(
                to bottom,
                transparent 0%,
                transparent 52%,
                #090314 52%,
                #090314 55%,
                transparent 55%,
                transparent 63%,
                #090314 63%,
                #090314 67%,
                transparent 67%,
                transparent 74%,
                #090314 74%,
                #090314 79%,
                transparent 79%,
                transparent 85%,
                #090314 85%,
                #090314 92%
            );
        }

        /* Efectos de Texto Neón Animado */
        .neon-text-pink {
            color: #fff;
            text-shadow:
                0 0 5px #fff,
                0 0 12px var(--neon-pink),
                0 0 25px var(--neon-pink),
                0 0 45px var(--neon-pink);
            animation: neonFlicker 4s infinite alternate;
        }

        .neon-text-cyan {
            color: #fff;
            text-shadow:
                0 0 5px #fff,
                0 0 10px var(--neon-cyan),
                0 0 22px var(--neon-cyan),
                0 0 40px var(--neon-cyan);
        }

        .neon-script-vice {
            color: #ff9ce3;
            text-shadow:
                0 0 4px #fff,
                0 0 12px #ff007f,
                0 0 28px #ff007f,
                0 0 45px #9d00ff;
            transform: rotate(-4deg);
        }

        @keyframes neonFlicker {
            0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% {
                opacity: 1;
                text-shadow:
                    0 0 5px #fff,
                    0 0 12px var(--neon-pink),
                    0 0 25px var(--neon-pink),
                    0 0 45px var(--neon-pink);
            }
            20%, 24%, 55% {
                opacity: 0.82;
                text-shadow:
                    0 0 2px #fff,
                    0 0 6px var(--neon-pink);
            }
        }

        /* Animación sutil de palmeras con brisa de Miami */
        .palm-sway-left {
            transform-origin: bottom center;
            animation: swayLeft 6s ease-in-out infinite alternate;
        }
        .palm-sway-right {
            transform-origin: bottom center;
            animation: swayRight 7s ease-in-out infinite alternate;
        }

        @keyframes swayLeft {
            0% { transform: rotate(-2deg); }
            100% { transform: rotate(3deg); }
        }
        @keyframes swayRight {
            0% { transform: rotate(2deg); }
            100% { transform: rotate(-3deg); }
        }

        /* Tarjetas Glassmorphism con borde Neón GTA VI / Vice City */
        .vice-card {
            background: rgba(17, 7, 36, 0.78);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(0, 243, 255, 0.35);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.65), inset 0 0 18px rgba(157, 0, 255, 0.15);
            transition: all 0.3s ease;
        }

        .vice-card:hover {
            border-color: rgba(255, 0, 127, 0.65);
            box-shadow: 0 8px 36px rgba(255, 0, 127, 0.2), inset 0 0 22px rgba(0, 243, 255, 0.15);
        }

        /* Inputs Estilizados */
        .vice-input {
            background: rgba(9, 3, 20, 0.85);
            border: 1px solid rgba(157, 0, 255, 0.5);
            color: #fff;
            transition: all 0.25s ease;
        }
        .vice-input:focus {
            outline: none;
            border-color: #00f3ff;
            box-shadow: 0 0 14px rgba(0, 243, 255, 0.45);
        }

        /* Botón Neón Principal */
        .btn-vice-primary {
            background: linear-gradient(90deg, #ff007f 0%, #9d00ff 50%, #00f3ff 100%);
            background-size: 200% auto;
            color: #fff;
            text-shadow: 0 1px 3px rgba(0,0,0,0.6);
            box-shadow: 0 0 18px rgba(255, 0, 127, 0.55);
            transition: all 0.35s ease;
        }
        .btn-vice-primary:hover {
            background-position: right center;
            box-shadow: 0 0 26px rgba(0, 243, 255, 0.75);
            transform: translateY(-2px);
        }

        /* Scanlines sutiles estilo monitor CRT 90s */
        .crt-scanlines {
            position: fixed;
            inset: 0;
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.18) 50%
            );
            background-size: 100% 4px;
            z-index: 50;
            pointer-events: none;
            opacity: 0.45;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090314;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #ff007f, #00f3ff);
            border-radius: 999px;
        }
    </style>
</head>
