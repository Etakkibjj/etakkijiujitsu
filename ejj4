                </div>

                <!-- Contenedor de la Tabla Responsiva -->
                <div class="overflow-x-auto rounded-2xl border border-white/10 bg-black/30">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-vice-purple/40 bg-vice-purple/20 font-retro text-[11px] uppercase tracking-wider text-vice-cyan">
