    <!-- FOOTER RETRO -->
    <footer class="mt-16 text-center px-4 text-xs text-gray-400">
        <div class="max-w-2xl mx-auto border-t border-white/10 pt-6">
            <p class="font-retro tracking-widest text-vice-cyan uppercase">
                EJJI 4 • TORNEO NO-GI SUBMISSION ONLY • VERANO 2027
            </p>
            <p class="mt-1 text-gray-500">
                Vice City Grappling Series • Todos los derechos reservados
            </p>
        </div>
    </footer>

    <!-- LÓGICA DE LA APLICACIÓN EN JAVASCRIPT -->
    <script>
        (() => {
            // Clave de almacenamiento persistente
            const STORAGE_KEY = 'ejji4_nogi_2027_athletes_v1';

            // Estado principal de la aplicación
            let athletes = [];

            // Referencias al DOM
            const form = document.getElementById('registration-form');
            const nameInput = document.getElementById('athlete-name');
            const teamInput = document.getElementById('athlete-team');
            const beltInput = document.getElementById('athlete-belt');
            const weightKgInput = document.getElementById('athlete-weight-kg');
            const weightCatInput = document.getElementById('athlete-weight-cat');
            const ageInput = document.getElementById('athlete-age');
            const divisionInput = document.getElementById('athlete-division');

            const tbody = document.getElementById('athletes-tbody');
            const emptyState = document.getElementById('empty-state');
            const showingCount = document.getElementById('showing-count');

            const searchInput = document.getElementById('search-input');
            const filterBeltSelect = document.getElementById('filter-belt');

            const btnExportCsv = document.getElementById('btn-export-csv');
            const btnExportJson = document.getElementById('btn-export-json');
            const btnClearAll = document.getElementById('btn-clear-all');
            const btnSeedDemo = document.getElementById('btn-seed-demo');

            // Referencias Modal Confirmación
            const confirmModal = document.getElementById('confirm-modal');
            const confirmTitle = document.getElementById('confirm-title');
            const confirmMessage = document.getElementById('confirm-message');
            const confirmCancel = document.getElementById('confirm-cancel');
            const confirmOk = document.getElementById('confirm-ok');
            let pendingConfirmCallback = null;

            // Estilos visuales por Faixa / Cinturón
            const BELT_STYLES = {
                'Blanca': {
                    badge: 'bg-white/95 text-gray-900 border-gray-300 shadow-[0_0_10px_rgba(255,255,255,0.4)]',
                    dot: 'bg-gray-900'
                },
                'Azul': {
                    badge: 'bg-blue-600/30 text-blue-200 border-blue-400 shadow-[0_0_10px_rgba(59,130,246,0.4)]',
                    dot: 'bg-blue-400'
                },
                'Violeta': {
                    badge: 'bg-purple-600/30 text-purple-200 border-purple-400 shadow-[0_0_10px_rgba(168,85,247,0.4)]',
                    dot: 'bg-purple-400'
                },
                'Marrón': {
                    badge: 'bg-amber-800/40 text-amber-200 border-amber-500 shadow-[0_0_10px_rgba(217,119,6,0.4)]',
                    dot: 'bg-amber-500'
                },
                'Negra': {
                    badge: 'bg-neutral-900 text-vice-pink border-vice-pink shadow-[0_0_12px_rgba(255,0,127,0.5)]',
                    dot: 'bg-vice-pink'
                }
            };

            // ==========================================
            // 1. UTILIDADES DE NOTIFICACIÓN Y MODAL
            // ==========================================
            function showToast(message, type = 'success') {
                const container = document.getElementById('toast-container');
                const toast = document.createElement('div');
                
                const colors = {
                    success: 'border-vice-cyan bg-vice-card/95 text-white shadow-[0_0_20px_rgba(0,243,255,0.4)]',
                    pink: 'border-vice-pink bg-vice-card/95 text-white shadow-[0_0_20px_rgba(255,0,127,0.4)]',
                    error: 'border-red-500 bg-vice-card/95 text-red-200 shadow-[0_0_20px_rgba(239,68,68,0.4)]'
                };

                const icons = {
                    success: '<i class="fa-solid fa-circle-check text-vice-cyan text-lg"></i>',
                    pink: '<i class="fa-solid fa-bolt text-vice-pink text-lg"></i>',
                    error: '<i class="fa-solid fa-circle-exclamation text-red-400 text-lg"></i>'
                };

                toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border ${colors[type] || colors.success} backdrop-blur-md transition-all duration-300 transform translate-x-full opacity-0`;
                toast.innerHTML = `
                    ${icons[type] || icons.success}
                    <span class="text-xs sm:text-sm font-semibold">${message}</span>
                `;

                container.appendChild(toast);

                // Animar entrada
                requestAnimationFrame(() => {
                    toast.classList.remove('translate-x-full', 'opacity-0');
                });

                // Auto-remover después de 3.2 segundos
                setTimeout(() => {
                    toast.classList.add('translate-x-full', 'opacity-0');
                    setTimeout(() => toast.remove(), 300);
                }, 3200);
            }

            function openConfirmModal(title, message, onConfirm) {
                confirmTitle.textContent = title;
                confirmMessage.textContent = message;
                pendingConfirmCallback = onConfirm;
                confirmModal.classList.remove('hidden');
                confirmModal.classList.add('flex');
            }

            function closeConfirmModal() {
                confirmModal.classList.add('hidden');
                confirmModal.classList.remove('flex');
                pendingConfirmCallback = null;
            }

            confirmCancel.addEventListener('click', closeConfirmModal);
            confirmOk.addEventListener('click', () => {
                if (typeof pendingConfirmCallback === 'function') {
                    pendingConfirmCallback();
                }
                closeConfirmModal();
            });

            // ==========================================
            // 2. AUTO-SELECCIÓN INTELIGENTE DE CATEGORÍA Y DIVISIÓN
            // ==========================================
            weightKgInput.addEventListener('input', () => {
                const kg = parseFloat(weightKgInput.value);
                if (isNaN(kg)) return;

                if (kg <= 57.5) weightCatInput.value = 'Gallo (-57.5 kg)';
                else if (kg <= 64.0) weightCatInput.value = 'Pluma (-64 kg)';
                else if (kg <= 70.0) weightCatInput.value = 'Pena (-70 kg)';
                else if (kg <= 76.0) weightCatInput.value = 'Ligero (-76 kg)';
                else if (kg <= 82.3) weightCatInput.value = 'Medio (-82.3 kg)';
                else if (kg <= 88.3) weightCatInput.value = 'Medio-Pesado (-88.3 kg)';
                else if (kg <= 94.3) weightCatInput.value = 'Pesado (-94.3 kg)';
                else if (kg <= 100.5) weightCatInput.value = 'Super-Pesado (-100.5 kg)';
                else weightCatInput.value = 'Pesadísimo (+100.5 kg)';
            });

            ageInput.addEventListener('input', () => {
                const age = parseInt(ageInput.value, 10);
                if (isNaN(age)) return;

                if (age < 18) divisionInput.value = 'Juvenil (14-17)';
                else if (age <= 29) divisionInput.value = 'Adulto (18-29)';
                else if (age <= 35) divisionInput.value = 'Master 1 (30-35)';
                else if (age <= 40) divisionInput.value = 'Master 2 (36-40)';
                else divisionInput.value = 'Master 3+ (+41)';
            });

            // ==========================================
            // 3. PERSISTENCIA EN LOCALSTORAGE
            // ==========================================
            function loadAthletes() {
                try {
                    const saved = localStorage.getItem(STORAGE_KEY);
                    if (saved) {
                        athletes = JSON.parse(saved);
                    }
                } catch (err) {
                    console.error('Error leyendo localStorage:', err);
                    athletes = [];
                }
            }

            function saveAthletes() {
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(athletes));
                } catch (err) {
                    console.error('Error guardando en localStorage:', err);
                    showToast('No se pudo guardar en el navegador.', 'error');
                }
            }

            // ==========================================
            // 4. ACTUALIZACIÓN DE CONTADORES Y RENDERIZADO
            // ==========================================
            function updateStats() {
                document.getElementById('stat-total').textContent = athletes.length;
                
                const belts = ['Blanca', 'Azul', 'Violeta', 'Marrón', 'Negra'];
                belts.forEach(belt => {
                    const count = athletes.filter(a => a.belt === belt).length;
                    const el = document.getElementById(`stat-${belt}`);
                    if (el) el.textContent = count;
                });
            }

            function escapeHTML(str) {
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function renderTable() {
                const query = searchInput.value.trim().toLowerCase();
                const beltFilter = filterBeltSelect.value;

                // Filtrar atletas
                const filtered = athletes.filter(athlete => {
                    const matchesBelt = beltFilter === 'ALL' || athlete.belt === beltFilter;
                    const matchesText = 
                        athlete.name.toLowerCase().includes(query) ||
                        (athlete.team && athlete.team.toLowerCase().includes(query)) ||
                        athlete.weightCategory.toLowerCase().includes(query) ||
                        athlete.division.toLowerCase().includes(query);
                    return matchesBelt && matchesText;
                });

                tbody.innerHTML = '';

                if (filtered.length === 0) {
                    emptyState.classList.remove('hidden');
                } else {
                    emptyState.classList.add('hidden');
                    
                    filtered.forEach((athlete, index) => {
                        const style = BELT_STYLES[athlete.belt] || BELT_STYLES['Blanca'];
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-white/5 transition-colors group';

                        tr.innerHTML = `
                            <td class="py-3.5 px-4 font-retro text-xs text-gray-400">
                                ${String(index + 1).padStart(2, '0')}
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="font-bold text-white group-hover:text-vice-cyan transition-colors">
                                    ${escapeHTML(athlete.name)}
                                </div>
                                <div class="text-xs text-gray-400">
                                    ${athlete.team ? escapeHTML(athlete.team) : '<span class="italic text-gray-500">Independiente</span>'}
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-retro font-bold border ${style.badge}">
                                    <span class="w-2 h-2 rounded-full ${style.dot}"></span>
                                    ${escapeHTML(athlete.belt)}
                                </span>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="font-retro text-xs font-bold text-vice-orange">
                                    ${athlete.weightKg} kg
                                </div>
                                <div class="text-xs text-gray-300">
                                    ${escapeHTML(athlete.weightCategory)}
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="font-bold text-white text-xs">
                                    ${athlete.age} años
                                </div>
                                <div class="text-[11px] text-vice-pink font-medium">
                                    ${escapeHTML(athlete.division)}
                                </div>
                            </td>
                            <td class="py-3.5 px-4 text-right">
                                <button type="button" data-id="${athlete.id}"
                                    class="btn-delete-athlete p-2 rounded-lg bg-red-500/10 hover:bg-red-500/30 text-red-400 hover:text-red-200 border border-transparent hover:border-red-500/40 transition cursor-pointer"
                                    title="Eliminar registro">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                }

                showingCount.textContent = `Mostrando ${filtered.length} de ${athletes.length} atletas`;
                updateStats();
            }

            // ==========================================
            // 5. EVENTOS DE FORMULARIO Y ACCIONES
            // ==========================================
            form.addEventListener('submit', (e) => {
                e.preventDefault();

                const name = nameInput.value.trim();
                const team = teamInput.value.trim();
                const belt = beltInput.value;
                const weightKg = parseFloat(weightKgInput.value);
                const weightCategory = weightCatInput.value;
                const age = parseInt(ageInput.value, 10);
                const division = divisionInput.value;

                if (!name || isNaN(weightKg) || isNaN(age)) {
                    showToast('Por favor completa todos los campos obligatorios.', 'error');
                    return;
                }

                const newAthlete = {
                    id: Date.now().toString(36) + Math.random().toString(36).substring(2, 6),
                    name,
                    team,
                    belt,
                    weightKg: weightKg.toFixed(1),
                    weightCategory,
                    age,
                    division,
                    registeredAt: new Date().toISOString()
                };

                // Agregar al inicio de la lista para verlo al instante
                athletes.unshift(newAthlete);
                saveAthletes();
                renderTable();

                // Limpiar campos de texto/número manteniendo selecciones cómodas
                nameInput.value = '';
                teamInput.value = '';
                weightKgInput.value = '';
                ageInput.value = '';
                nameInput.focus();

                showToast(`¡${name} pre-inscripto en EJJI 4!`, 'pink');
            });

            // Delegación de evento para eliminar atleta individual
            tbody.addEventListener('click', (e) => {
                const btn = e.target.closest('.btn-delete-athlete');
                if (!btn) return;

                const id = btn.getAttribute('data-id');
                const target = athletes.find(a => a.id === id);
                if (!target) return;

                openConfirmModal(
                    'ELIMINAR ATLETA',
                    `¿Deseas quitar a "${target.name}" (${target.belt} - ${target.weightCategory}) de la lista de pre-inscriptos?`,
                    () => {
                        athletes = athletes.filter(a => a.id !== id);
                        saveAthletes();
                        renderTable();
                        showToast(`Registro de ${target.name} eliminado.`, 'success');
                    }
                );
            });

            // Filtros en tiempo real
            searchInput.addEventListener('input', renderTable);
            filterBeltSelect.addEventListener('change', renderTable);

            // Vaciar toda la lista
            btnClearAll.addEventListener('click', () => {
                if (athletes.length === 0) {
                    showToast('La lista ya se encuentra vacía.', 'error');
                    return;
                }
                openConfirmModal(
                    'VACIAR LISTA COMPLETA',
                    `Estás a punto de eliminar los ${athletes.length} atletas registrados. Esta acción no se puede deshacer.`,
                    () => {
                        athletes = [];
                        saveAthletes();
                        renderTable();
                        showToast('Lista de pre-inscriptos vaciada.', 'pink');
                    }
                );
            });

            // Cargar atletas de ejemplo
            btnSeedDemo.addEventListener('click', () => {
                const demoAthletes = [
                    {
                        id: 'demo1-' + Date.now(),
                        name: 'Tommy Vercetti',
                        team: 'Ocean Beach Jiu-Jitsu',
                        belt: 'Negra',
                        weightKg: '81.5',
                        weightCategory: 'Medio (-82.3 kg)',
                        age: 34,
                        division: 'Master 1 (30-35)',
                        registeredAt: new Date().toISOString()
                    },
                    {
                        id: 'demo2-' + Date.now(),
                        name: 'Lucia Caminos',
                        team: 'Vice City Top Team',
                        belt: 'Marrón',
                        weightKg: '63.2',
                        weightCategory: 'Pluma (-64 kg)',
                        age: 26,
                        division: 'Adulto (18-29)',
                        registeredAt: new Date().toISOString()
                    },
                    {
                        id: 'demo3-' + Date.now(),
                        name: 'Jason Duval',
                        team: 'Leonida Grappling',
                        belt: 'Violeta',
                        weightKg: '87.8',
                        weightCategory: 'Medio-Pesado (-88.3 kg)',
                        age: 28,
                        division: 'Adulto (18-29)',
                        registeredAt: new Date().toISOString()
                    },
                    {
                        id: 'demo4-' + Date.now(),
                        name: 'Lance Vance',
                        team: 'Starfish Island BJJ',
                        belt: 'Azul',
                        weightKg: '75.4',
                        weightCategory: 'Ligero (-76 kg)',
                        age: 23,
                        division: 'Adulto (18-29)',
                        registeredAt: new Date().toISOString()
                    }
                ];

                athletes = [...demoAthletes, ...athletes];
                saveAthletes();
                renderTable();
                showToast('4 atletas de ejemplo cargados al torneo.', 'success');
            });

            // ==========================================
            // 6. EXPORTACIÓN A CSV Y JSON
            // ==========================================
            function downloadFile(content, filename, mimeType) {
                const blob = new Blob([content], { type: mimeType });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }

            btnExportCsv.addEventListener('click', () => {
                if (athletes.length === 0) {
                    showToast('No hay atletas para exportar.', 'error');
                    return;
                }

                // Cabeceras CSV con BOM UTF-8 para compatibilidad total con Excel en español
                const headers = ['Nro', 'Nombre Completo', 'Academia/Equipo', 'Faixa', 'Peso (kg)', 'Categoria Peso', 'Edad', 'Division', 'Fecha Registro'];
                const rows = athletes.map((a, idx) => [
                    idx + 1,
                    `"${a.name.replace(/"/g, '""')}"`,
                    `"${(a.team || 'Independiente').replace(/"/g, '""')}"`,
                    `"${a.belt}"`,
                    a.weightKg,
                    `"${a.weightCategory}"`,
                    a.age,
                    `"${a.division}"`,
                    `"${new Date(a.registeredAt).toLocaleString('es-AR')}"`
                ]);

                const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
                downloadFile(csvContent, 'EJJI4_PreInscriptos_Verano2027.csv', 'text/csv;charset=utf-8;');
                showToast('Planilla CSV descargada correctamente.', 'success');
            });

            btnExportJson.addEventListener('click', () => {
                if (athletes.length === 0) {
                    showToast('No hay atletas para exportar.', 'error');
                    return;
                }

                const payload = {
                    torneo: 'EJJI 4 - Torneo No-Gi Submission Only',
                    edicion: 'Verano 2027',
                    exportadoEl: new Date().toISOString(),
                    totalInscriptos: athletes.length,
                    atletas: athletes
                };

                const jsonContent = JSON.stringify(payload, null, 2);
                downloadFile(jsonContent, 'EJJI4_Roster_Verano2027.json', 'application/json');
                showToast('Archivo JSON descargado correctamente.', 'success');
            });

            // Inicializar aplicación al cargar
            loadAthletes();
            renderTable();
        })();
    </script>
</body>
</html>
