                                <th class="py-3.5 px-4 text-right">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="athletes-tbody" class="divide-y divide-white/10 text-sm">
                            <!-- Filas renderizadas dinámicamente por JS -->
                        </tbody>
                    </table>

                    <!-- Estado Vacío -->
                    <div id="empty-state" class="hidden py-12 px-4 text-center">
                        <div class="w-16 h-16 mx-auto rounded-full bg-vice-purple/20 border border-vice-purple/50 flex items-center justify-center text-vice-pink text-2xl mb-3 shadow-[0_0_20px_rgba(157,0,255,0.3)]">
                            <i class="fa-solid fa-person-falling-burst"></i>
                        </div>
                        <h3 class="font-retro text-base font-bold text-white">TATAMI VACÍO</h3>
                        <p class="text-xs text-gray-400 max-w-xs mx-auto mt-1">
                            No hay atletas registrados con los filtros actuales. ¡Inscribe al primer competidor en el formulario!
                        </p>
                    </div>
                </div>

                <!-- Pie de Tabla Informativo -->
                <div class="mt-4 flex flex-wrap items-center justify-between text-xs text-gray-400 gap-2">
                    <span id="showing-count">Mostrando 0 atletas</span>
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Sincronizado en almacenamiento local
